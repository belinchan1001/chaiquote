<!--
    ic_maskable is android/icons/icon-512-adaptive.png, already inset so the
    blue ring sits inside the 66dp safe zone of this 108dp layer.
    Bubblewrap's 8.5dp inset is for a full-bleed maskable and would crop or
    shrink that ring. No extra padding here.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_maskable" />
</adaptive-icon>
